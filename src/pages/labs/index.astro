---
import { getCollection } from 'astro:content';
import PageLayout from '~/layouts/PageLayout.astro';
import Container from '~/components/layout/Container.astro';
import IndexHeader from '~/components/universal/IndexHeader.astro';
import EntryList from '~/components/universal/EntryList.astro';

// Several reports share a date, so ties break on the report number, newest first.
const entries = (await getCollection('labs')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime() || b.data.id.localeCompare(a.data.id)
);
const items = entries.map((e) => ({
  href: `/labs/${e.id}/`, id: e.data.id.toUpperCase(), title: e.data.title, line: e.data.description,
  date: e.data.date, minutes: e.data.readingTime, image: e.data.spot, imageKind: 'spot' as const,
}));
---

<PageLayout
  title="Labs — Agent Engineering Lab"
  description="Empirical Lab Reports. Every claim reproducible from repo + data + seed."
  currentNav="Labs"
>
  <Container maxWidth="1080px">
    <IndexHeader
      title="Labs"
      dek="Lab reports on agent architecture. Each one states its hypothesis, method and results, says what went wrong, and publishes the repo, the data and the seed."
    />
    {items.length === 0 ? <p class="index-empty">No Labs yet.</p> : <EntryList items={items} lead label="Lab reports, newest first" />}
  </Container>
</PageLayout>

<style>
  .index-empty { color: var(--fg-light); font-style: italic; margin: var(--space-7) 0; }
</style>

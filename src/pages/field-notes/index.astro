---
import { getCollection } from 'astro:content';
import PageLayout from '~/layouts/PageLayout.astro';
import Container from '~/components/layout/Container.astro';
import IndexHeader from '~/components/universal/IndexHeader.astro';
import EntryList from '~/components/universal/EntryList.astro';

const entries = (await getCollection('fieldNotes')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const items = entries.map((e) => ({
  href: `/field-notes/${e.id}/`, id: e.data.id.toUpperCase(), title: e.data.title, line: e.data.dek,
  date: e.data.date, minutes: e.data.readingTime, image: e.data.spot, imageKind: 'spot' as const,
}));
---

<PageLayout
  title="Field Notes — Agent Engineering Lab"
  description="Field Notes on building agents that survive contact with reality."
  currentNav="Field Notes"
>
  <Container maxWidth="1080px">
    <IndexHeader title="Field Notes" dek="Notes from inside the work of building agents that survive contact with reality." />
    {items.length === 0 ? <p class="index-empty">No Field Notes published yet.</p> : <EntryList items={items} lead label="Field Notes, newest first" />}
  </Container>
</PageLayout>

<style>
  .index-empty { color: var(--fg-light); font-style: italic; margin: var(--space-7) 0; }
</style>

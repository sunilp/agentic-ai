---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import FieldNoteLayout from '~/layouts/FieldNoteLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('fieldNotes');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'fieldNotes'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<FieldNoteLayout entry={entry}>
  <Content />
</FieldNoteLayout>

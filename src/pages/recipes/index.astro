---
import { getCollection } from 'astro:content';
import PageLayout from '~/layouts/PageLayout.astro';
import Container from '~/components/layout/Container.astro';
import IndexHeader from '~/components/universal/IndexHeader.astro';
import EntryList from '~/components/universal/EntryList.astro';

const entries = (await getCollection('recipes')).sort((a, b) => b.data.verifiedOn.getTime() - a.data.verifiedOn.getTime());
const items = entries.map((e) => ({
  href: `/recipes/${e.id}/`, id: e.data.id.toUpperCase(), title: e.data.title, line: e.data.description,
  date: e.data.verifiedOn, dateLabel: 'Verified', minutes: e.data.estimatedMinutes, image: e.data.spot, imageKind: 'spot' as const,
}));
---

<PageLayout
  title="Recipes — Agent Engineering Lab"
  description="Verified-on-real-systems Recipes. Build it in an afternoon."
  currentNav="Recipes"
>
  <Container maxWidth="1080px">
    <IndexHeader
      title="Recipes"
      dek="Build it in an afternoon. Every recipe is verified end to end against a live system, on a known date, with explicit versions."
    />
    {items.length === 0 ? <p class="index-empty">No Recipes published yet.</p> : <EntryList items={items} lead label="Recipes, newest first" />}
  </Container>
</PageLayout>

<style>
  .index-empty { color: var(--fg-light); font-style: italic; margin: var(--space-7) 0; }
</style>

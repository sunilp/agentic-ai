---
import { getCollection } from 'astro:content';
import PageLayout from '~/layouts/PageLayout.astro';
import Container from '~/components/layout/Container.astro';
import MagazineGrid from '~/components/layout/MagazineGrid.astro';
import ArticleHeader from '~/components/universal/ArticleHeader.astro';
import Cadence from '~/components/universal/Cadence.astro';
import EntryCard from '~/components/universal/EntryCard.astro';

const entries = await getCollection('recipes');
const sorted = entries.sort((a, b) => b.data.verifiedOn.getTime() - a.data.verifiedOn.getTime());
---

<PageLayout
  title="Recipes — Agent Engineering Lab"
  description="Verified-on-real-systems Recipes. Build it in an afternoon."
  currentNav="Recipes"
>
  <Container>
    <div class="r-index__header">
      <ArticleHeader
        rubric="RECIPES"
        title="Recipes"
        dek="Build it in an afternoon. Every Recipe verified end-to-end against a live system on a known date with explicit versions."
      />
      <Cadence text="Every other Wednesday" />
    </div>

    {sorted.length === 0 ? (
      <p class="r-index__empty">No Recipes published yet.</p>
    ) : (
      <MagazineGrid cols={3}>
        {sorted.map((e) => (
          <EntryCard
            href={`/recipes/${e.id}/`}
            rubric={`RECIPE · ${e.data.id.toUpperCase()} · Verified ${e.data.verifiedOn.toISOString().slice(0, 10)}`}
            title={e.data.title}
            line={e.data.description}
            image={e.data.spot}
            imageKind="spot"
          />
        ))}
      </MagazineGrid>
    )}
  </Container>
</PageLayout>

<style>
  .r-index__header {
    margin: var(--space-7) 0 var(--space-6);
    text-align: center;
  }

  .r-index__header :global(.cadence) { margin-top: var(--space-2); }

  .r-index__empty {
    color: var(--fg-light);
    font-style: italic;
    margin: var(--space-7) 0;
  }
</style>

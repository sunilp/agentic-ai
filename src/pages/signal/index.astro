---
import { getCollection } from 'astro:content';
import PageLayout from '~/layouts/PageLayout.astro';
import Container from '~/components/layout/Container.astro';
import IndexHeader from '~/components/universal/IndexHeader.astro';
import EntryList from '~/components/universal/EntryList.astro';

const entries = (await getCollection('signal')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const items = entries.map((e) => ({
  href: `/signal/${e.id}/`, id: e.data.id.toUpperCase(), title: e.data.title, line: e.data.dek,
  date: e.data.date, minutes: e.data.readingTime, image: e.data.banner, imageKind: 'banner' as const,
}));
---

<PageLayout
  title="Signal — Agent Engineering Lab"
  description="Commentary on the discourse around building agents. What to keep, what to skip."
  currentNav="Signal"
>
  <Container maxWidth="1080px">
    <IndexHeader
      title="Signal"
      dek="What to keep, what to skip. Commentary on the talk around agent engineering: papers, tools, marketplaces and claims. Field Notes report from inside the work. Signal reads what everyone else is saying."
    />
    {items.length === 0 ? <p class="index-empty">No Signal pieces published yet.</p> : <EntryList items={items} lead label="Signal pieces, newest first" />}
  </Container>
</PageLayout>

<style>
  .index-empty { color: var(--fg-light); font-style: italic; margin: var(--space-7) 0; }
</style>

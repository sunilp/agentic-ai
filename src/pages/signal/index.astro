---
import { getCollection } from 'astro:content';
import PageLayout from '~/layouts/PageLayout.astro';
import Container from '~/components/layout/Container.astro';
import MagazineGrid from '~/components/layout/MagazineGrid.astro';
import KineticHeading from '~/components/universal/KineticHeading.astro';
import Dek from '~/components/universal/Dek.astro';
import Tag from '~/components/universal/Tag.astro';

const entries = await getCollection('signal');
const sorted = entries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<PageLayout
  title="Signal — Agentic AI for Serious Engineers"
  description="Commentary on the discourse around building agents. What to keep, what to skip."
  currentNav="Signal"
>
  <Container>
    <header class="sg-index__header">
      <Tag variant="accent">Signal</Tag>
      <KineticHeading level={1}>Signal</KineticHeading>
      <Dek italic>What to keep, what to skip. Commentary on the discourse around agent engineering: papers, tools, marketplaces, claims. Distinct from Field Notes, which report from inside the work.</Dek>
    </header>

    {sorted.length === 0 ? (
      <p class="sg-index__empty">No Signal pieces published yet.</p>
    ) : (
      <MagazineGrid cols={3}>
        {sorted.map((e) => (
          <a class="sg-index__card" href={`/agentic-ai/signal/${e.id}/`}>
            <img
              src={e.data.banner}
              alt={`${e.data.title} banner`}
              class="sg-index__banner"
              loading="lazy"
              width="600"
              height="315"
            />
            <div class="sg-index__kicker">{e.data.id.toUpperCase()} · {e.data.date.toISOString().slice(0, 10)}</div>
            <h2 class="sg-index__title">{e.data.title}</h2>
            <p class="sg-index__dek">{e.data.dek}</p>
            <div class="sg-index__cta">{e.data.readingTime} min read →</div>
          </a>
        ))}
      </MagazineGrid>
    )}
  </Container>
</PageLayout>

<style>
  .sg-index__header { margin: var(--space-7) 0 var(--space-6); }
  .sg-index__header :global(.tag) { margin-bottom: var(--space-3); }
  .sg-index__header :global(.kinetic-heading) { font-size: var(--display-1); }

  .sg-index__empty {
    color: var(--fg-light);
    font-style: italic;
    margin: var(--space-7) 0;
  }

  .sg-index__card {
    color: var(--fg);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: transform var(--dur-micro) var(--ease-out);
  }

  .sg-index__card:hover { transform: translateY(-2px); }

  .sg-index__banner {
    width: 100%;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    background: var(--paper-recess);
    border: 1px solid var(--fg-faint);
    border-radius: var(--radius-sm);
  }

  .sg-index__kicker {
    font-family: var(--font-mono);
    font-size: var(--meta-3);
    text-transform: uppercase;
    letter-spacing: var(--tracking-loose);
    color: var(--brick);
  }

  .sg-index__title {
    font-family: var(--font-display);
    font-size: var(--display-3);
    line-height: var(--lh-snug);
    font-weight: 500;
    margin: 0;
  }

  .sg-index__dek {
    color: var(--fg-light);
    font-size: var(--body-2);
    line-height: var(--lh-snug);
    margin: 0;
  }

  .sg-index__cta {
    font-family: var(--font-mono);
    font-size: var(--meta-3);
    text-transform: uppercase;
    letter-spacing: var(--tracking-loose);
    color: var(--brick);
    margin-top: auto;
  }
</style>

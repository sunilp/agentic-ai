---
import { getCollection } from 'astro:content';
import PageLayout from '~/layouts/PageLayout.astro';
import Container from '~/components/layout/Container.astro';
import MagazineGrid from '~/components/layout/MagazineGrid.astro';
import ArticleHeader from '~/components/universal/ArticleHeader.astro';
import EntryCard from '~/components/universal/EntryCard.astro';

const entries = await getCollection('signal');
const sorted = entries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<PageLayout
  title="Signal — Agent Engineering Lab"
  description="Commentary on the discourse around building agents. What to keep, what to skip."
  currentNav="Signal"
>
  <Container>
    <div class="sg-index__header">
      <ArticleHeader
        rubric="SIGNAL"
        title="Signal"
        dek="What to keep, what to skip. Commentary on the discourse around agent engineering: papers, tools, marketplaces, claims. Distinct from Field Notes, which report from inside the work."
      />
    </div>

    {sorted.length === 0 ? (
      <p class="sg-index__empty">No Signal pieces published yet.</p>
    ) : (
      <MagazineGrid cols={3}>
        {sorted.map((e) => (
          <EntryCard
            href={`/signal/${e.id}/`}
            rubric={`SIGNAL · ${e.data.id.toUpperCase()} · ${e.data.date.toISOString().slice(0, 10)}`}
            title={e.data.title}
            line={e.data.dek}
            image={e.data.banner}
            imageKind="banner"
          />
        ))}
      </MagazineGrid>
    )}
  </Container>
</PageLayout>

<style>
  .sg-index__header { margin: var(--space-7) 0 var(--space-6); }

  .sg-index__empty {
    color: var(--fg-light);
    font-style: italic;
    margin: var(--space-7) 0;
  }
</style>

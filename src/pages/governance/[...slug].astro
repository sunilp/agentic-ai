---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import GovernanceLayout from '~/layouts/GovernanceLayout.astro';
import GovTable from '~/components/governance/GovTable.astro';
import { stepAnchors } from '~/lib/governance-anchors';

export async function getStaticPaths() {
  const entries = await getCollection('governance');
  return entries
    .filter((e) => e.data.status !== 'draft')
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props { entry: CollectionEntry<'governance'> }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const anchors = stepAnchors(headings, entry.body);
---
<GovernanceLayout entry={entry} anchors={anchors}>
  <Content components={{ table: GovTable }} />
</GovernanceLayout>

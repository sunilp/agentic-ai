---
import PageLayout from '~/layouts/PageLayout.astro';
import Container from '~/components/layout/Container.astro';
import HeroEditorial from '~/components/homepage/HeroEditorial.astro';
import EvidenceInlineStrip from '~/components/homepage/EvidenceInlineStrip.astro';
import BuildJudgeOperateCards from '~/components/homepage/BuildJudgeOperateCards.astro';
import WhatsNewStrip from '~/components/homepage/WhatsNewStrip.astro';
import ManifestoPullquote from '~/components/homepage/ManifestoPullquote.astro';
import TraceReplay from '~/components/islands/TraceReplay.svelte';
---

<PageLayout
  title="Agentic AI for Serious Engineers — Build agents that survive contact with reality"
  description="A field guide to building reliable, evaluable, production-grade agent systems. Book + Lab Reports + Field Notes + Recipes."
  ogImage="/og-default.png"
>
  <Container>
    <HeroEditorial />
    <EvidenceInlineStrip />
    <BuildJudgeOperateCards />
    <WhatsNewStrip />
  </Container>

  <ManifestoPullquote />

  <Container>
    <TraceReplay client:visible />
  </Container>
</PageLayout>

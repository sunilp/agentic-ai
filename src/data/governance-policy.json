{
  "source": "ai-governance-framework@v2.4.0",
  "tiers": {
    "T1": {
      "name": "Critical",
      "approver": "AI Risk Committee",
      "validation": "MRM (full scope)",
      "reviewCadence": "Quarterly",
      "metricsReview": "Daily dashboard check by AI Operations, plus a monthly system-owner review",
      "revalidation": "Annual, and on material change",
      "redTeam": "200+, including manual testing (external testers recommended)"
    },
    "T2": {
      "name": "High",
      "approver": "AI Risk (second line)",
      "validation": "MRM or another second-line reviewer outside the development team (reduced scope)",
      "reviewCadence": "Semi-annual",
      "metricsReview": "Weekly",
      "revalidation": "Every 24 months, and on material change",
      "redTeam": "100+"
    },
    "T3": {
      "name": "Medium",
      "approver": "Team lead",
      "validation": "Peer review",
      "reviewCadence": "Annual",
      "metricsReview": "Monthly",
      "revalidation": "On material change (peer re-review)",
      "redTeam": "Automated adversarial scan + 50 manual cases"
    },
    "T4": {
      "name": "Low",
      "approver": "Team lead (self-assessment acknowledged)",
      "validation": "Self-test",
      "reviewCadence": "Annual self-assessment",
      "metricsReview": "Quarterly",
      "revalidation": "On material change (peer re-review)",
      "redTeam": "Automated scan, 20+ cases (recommended)"
    }
  },

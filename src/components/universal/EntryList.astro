---
/**
 * EntryList: a dated list of pieces for a section index. One row per piece:
 * art, identifier, title, one line, date and reading time. With `lead`, the
 * newest piece is set larger. The same row language as the home feed and the
 * Architecture ledger, so every index reads the same way.
 */
export interface EntryItem {
  href: string;
  id?: string;            // a real identifier such as FN-004; set in mono
  title: string;
  line?: string;
  date?: Date;
  dateLabel?: string;     // e.g. "Verified"
  minutes?: number;
  image?: string;
  imageKind?: 'spot' | 'banner';
}
interface Props { items: EntryItem[]; lead?: boolean; label?: string }
const { items, lead = false, label = 'Pieces, newest first' } = Astro.props;
const webp = (src: string) => src.replace(/\.(png|jpe?g)$/, '.webp');
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<ol class="entry-list" aria-label={label}>
  {items.map((i, n) => (
    <li>
      <a class:list={['entry-row', lead && n === 0 && 'entry-row--lead', !i.image && 'entry-row--bare']} href={i.href}>
        {i.image && (
          <span class:list={['entry-row__art', `entry-row__art--${i.imageKind ?? 'spot'}`]}>
            <img src={i.image} alt="" loading={n < 2 ? 'eager' : 'lazy'} decoding="async" width={i.imageKind === 'banner' ? 1200 : 1024} height={i.imageKind === 'banner' ? 630 : 768} />
          </span>
        )}
        <span class="entry-row__text">
          <span class="entry-row__meta">
            {i.id && <span class="entry-row__id">{i.id}</span>}
            {i.date && <span class="entry-row__date">{i.dateLabel ? `${i.dateLabel} ` : ''}{fmt(i.date)}</span>}
          </span>
          <span class="entry-row__title">{i.title}</span>
          {i.line && <span class="entry-row__line">{i.line}</span>}
        </span>
        {i.minutes && <span class="entry-row__time">{i.minutes} min</span>}
      </a>
    </li>
  ))}
</ol>

<style>
  .entry-list { list-style: none; margin: 0 0 var(--space-8); padding: 0; }
  .entry-list li + li { border-top: 1px solid var(--fg-faint); }
  .entry-row {
    display: grid; grid-template-columns: 148px minmax(0, 1fr) auto; gap: var(--space-5);
    align-items: start; padding: var(--space-5) 0; color: var(--fg);
  }
  .entry-row--bare { grid-template-columns: minmax(0, 1fr) auto; }
  .entry-row__art { display: flex; align-items: center; justify-content: center; width: 148px; height: 111px; }
  .entry-row__art img { display: block; max-width: 100%; max-height: 100%; width: auto; height: auto; }
  .entry-row__art--spot img { mix-blend-mode: multiply; }
  .entry-row__art--banner img { width: 100%; height: 100%; object-fit: cover; border: 1px solid var(--fg-faint); border-radius: var(--radius-sm); }
  .entry-row__text, .entry-row__text > span { display: block; }
  .entry-row__meta { display: flex !important; flex-wrap: wrap; align-items: baseline; gap: 0 var(--space-3); }
  .entry-row__id { font-family: var(--font-mono); font-size: var(--meta-2); letter-spacing: 0.08em; color: var(--brick); }
  .entry-row__date { font-family: var(--font-body); font-style: italic; font-size: 15px; color: var(--fg-light); }
  .entry-row__title {
    font-family: var(--font-display); font-weight: 500; font-size: clamp(20px, 2.3vw, 24px);
    line-height: 1.25; margin-top: 4px; text-wrap: balance; transition: color var(--dur-micro) var(--ease-out);
  }
  .entry-row:hover .entry-row__title { color: var(--brick); }
  .entry-row__line { font-family: var(--font-body); font-size: 17px; line-height: 1.5; color: #4a4a48; margin-top: 6px; max-width: 68ch; }
  .entry-row__time { font-family: var(--font-body); font-style: italic; font-size: 15px; color: var(--fg-light); white-space: nowrap; padding-top: 2px; }

  /* The newest piece, set larger. */
  .entry-row--lead { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr) auto; gap: var(--space-7); align-items: center; padding: var(--space-4) 0 var(--space-6); }
  .entry-row--lead .entry-row__art { width: 100%; height: auto; max-height: 300px; }
  .entry-row--lead .entry-row__art--spot img { max-height: 300px; }
  .entry-row--lead .entry-row__art--banner img { height: auto; aspect-ratio: 1200 / 630; }
  .entry-row--lead .entry-row__title { font-weight: 400; font-size: var(--display-1); line-height: var(--lh-tight); letter-spacing: var(--tracking-tight); margin-top: var(--space-2); }
  .entry-row--lead .entry-row__line { font-size: var(--dek-size); color: #3c3c3a; margin-top: var(--space-3); }
  .entry-row--lead .entry-row__time { align-self: start; }

  @media (max-width: 720px) {
    .entry-row { grid-template-columns: 92px minmax(0, 1fr); gap: var(--space-4); }
    .entry-row--bare { grid-template-columns: minmax(0, 1fr); }
    .entry-row__art { width: 92px; height: 69px; }
    .entry-row__time { grid-column: 2; padding-top: 0; }
    .entry-row--bare .entry-row__time { grid-column: 1; }
    .entry-row--lead { grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
    .entry-row--lead .entry-row__time { grid-column: 1; }
    .entry-row--lead .entry-row__title { font-size: var(--display-2); }
  }
</style>

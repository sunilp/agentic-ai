---
/**
 * EntryCard — Gallery content card: spot art, mono rubric, Fraunces title, italic line.
 */
import Spot from './Spot.astro';

interface Props {
  href: string;
  rubric: string;       // 'FIELD NOTE · FN-004'
  title: string;
  line?: string;        // one italic sentence (dek or excerpt)
  image?: string;       // spot PNG path (imageKind 'spot') or banner path ('banner')
  imageKind?: 'spot' | 'banner';
}
const { href, rubric, title, line, image, imageKind = 'spot' } = Astro.props;
---

<a class="entry-card" href={href}>
  {image && imageKind === 'spot' && <div class="entry-card__art"><Spot src={image} size="card" /></div>}
  {image && imageKind === 'banner' && (
    <img class="entry-card__bannerimg" src={image} alt="" loading="lazy" width="600" height="315" />
  )}
  <div class="entry-card__rubric">{rubric}</div>
  <h2 class="entry-card__title">{title}</h2>
  {line && <p class="entry-card__line">{line}</p>}
</a>

<style>
  .entry-card { display: flex; flex-direction: column; color: var(--fg); }
  .entry-card__art { height: 120px; display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-4); }
  .entry-card__bannerimg {
    width: 100%; aspect-ratio: 1200 / 630; object-fit: cover;
    border: 1px solid var(--fg-faint); border-radius: var(--radius-sm);
    margin-bottom: var(--space-4); background: var(--paper-recess);
  }
  .entry-card__rubric {
    font-family: var(--font-mono); font-size: var(--meta-3);
    letter-spacing: var(--tracking-rubric); text-transform: uppercase; color: var(--brick);
  }
  .entry-card__title {
    font-family: var(--font-display); font-weight: 600; font-size: clamp(19px, 2.2vw, 22px);
    line-height: 1.25; margin: var(--space-2) 0 0;
  }
  .entry-card:hover .entry-card__title { color: var(--brick); }
  .entry-card__line {
    font-family: var(--font-body); font-style: italic; font-size: var(--display-4);
    color: #666; margin: var(--space-2) 0 0; line-height: 1.5;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
</style>

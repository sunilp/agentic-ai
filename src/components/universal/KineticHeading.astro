---
/**
 * KineticHeading — Fraunces large heading with fade-in reveal on first paint.
 * Used on hero only (one per page). On other pages use plain <h1>.
 * Falls back to instant render under prefers-reduced-motion.
 */
interface Props {
  level?: 1 | 2;
  class?: string;
}

const { level = 1, class: className } = Astro.props;
const Tag = `h${level}` as 'h1' | 'h2';
---

<Tag class:list={['kinetic-heading', className]} data-kinetic>
  <slot />
</Tag>

<style>
  .kinetic-heading {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    line-height: var(--lh-tight);
  }

  .kinetic-heading[data-kinetic-ready] {
    opacity: 0;
    animation: kinetic-fade var(--dur-hero) var(--ease-out) forwards;
  }

  @keyframes kinetic-fade {
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .kinetic-heading[data-kinetic-ready] {
      opacity: 1;
      animation: none;
    }
  }
</style>

<script>
  // Set data attribute after page load to avoid FOUC.
  document.querySelectorAll('[data-kinetic]').forEach((el) => {
    requestAnimationFrame(() => el.setAttribute('data-kinetic-ready', ''));
  });
</script>

---
/**
 * ChapterMap — visual sitemap of all 19 chapters, current one highlighted.
 * Renders as 5 stacked rows (one per Part) of tiny rectangles.
 */
import { getCollection } from 'astro:content';
import { isFree } from '~/lib/book';

interface Props {
  currentSlug: string;
}

const bookOnly = new Set((await getCollection('chapters')).filter((c) => !isFree(c)).map((c) => c.id));

const { currentSlug } = Astro.props;

const parts = [
  {
    label: 'Foundations',
    chapters: ['00a-how-llms-work', '00b-api-to-tools', '00c-first-agent', '00d-frameworks', '00e-connecting-to-mcp', '00f-the-production-boundary'],
  },
  {
    label: 'I · Build',
    chapters: ['01-what-agentic-means', '02-tools-context-agent-loop', '03-workflow-first-agent-second', '04-multi-agent-without-theater'],
  },
  {
    label: 'II · Judge',
    chapters: ['05-human-in-the-loop', '06-evaluating-and-hardening', '07-when-not-to-use-agents'],
  },
  {
    label: 'III · Operate',
    chapters: ['08-metacognition', '09-deployment', '10-governance', '11-security'],
  },
  {
    label: 'IV · Advanced',
    chapters: ['12-memory-management', '13-agent-protocols-in-production'],
  },
];

function chapterLabel(slug: string): string {
  return slug.split('-')[0];
}
---

<nav class="chapter-map" aria-label="Book chapter map">
  {parts.map((part) => (
    <div class="chapter-map__row">
      <div class="chapter-map__label">{part.label}</div>
      <div class="chapter-map__chips">
        {part.chapters.map((slug) => (
          <a
            href={`/book/${slug}/`}
            class:list={['chapter-map__chip', slug === currentSlug && 'chapter-map__chip--current', bookOnly.has(slug) && 'chapter-map__chip--book']}
            aria-label={`Chapter ${chapterLabel(slug)}${bookOnly.has(slug) ? ', preview, full text in the book' : ', free to read'}`}
            title={bookOnly.has(slug) ? 'Preview. The full chapter is in the book.' : 'Free to read'}
            aria-current={slug === currentSlug ? 'page' : undefined}
          >
            {chapterLabel(slug)}
          </a>
        ))}
      </div>
    </div>
  ))}
  <p class="chapter-map__key"><span class="chapter-map__chip">00</span> free to read <span class="chapter-map__chip chapter-map__chip--book">00</span> in the book</p>
</nav>

<style>
  .chapter-map {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--fg-faint);
  }

  .chapter-map__row {
    margin-bottom: var(--space-3);
  }

  .chapter-map__label {
    font-family: var(--font-mono);
    font-size: var(--meta-3);
    text-transform: uppercase;
    letter-spacing: var(--tracking-loose);
    color: var(--fg-light);
    margin-bottom: var(--space-1);
  }

  .chapter-map__key { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-family: var(--font-body); font-style: italic; font-size: 13.5px; color: var(--fg-light); margin: var(--space-3) 0 0; }
  .chapter-map__key .chapter-map__chip { color: transparent; min-width: 18px; padding: 2px 4px; }

  .chapter-map__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
  }

  .chapter-map__chip {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    padding: 2px 6px;
    background: var(--paper-recess);
    color: var(--fg-light);
    font-family: var(--font-mono);
    font-size: var(--meta-3);
    text-decoration: none;
    border-radius: 2px;
    transition: background var(--dur-micro) var(--ease-out), color var(--dur-micro) var(--ease-out);
  }

  .chapter-map__chip:hover {
    background: var(--fg-faint);
    color: var(--fg);
  }

  /* Book-only chapters: an outline instead of a fill, so the free ones stand out. */
  .chapter-map__chip--book { background: transparent; border: 1px dashed #c9c5bb; color: #999; }

  .chapter-map__chip--current {
    background: var(--brick);
    color: var(--paper);
    font-weight: 600;
  }
</style>

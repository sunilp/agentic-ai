---
/**
 * TopNav — 6-item primary navigation.
 * Sticky on scroll. Highlights current section.
 */
import Brand from './Brand.astro';

interface Props {
  current?: string;
}

const { current = '' } = Astro.props;

const items = [
  { href: '/start/', label: 'Start' },
  { href: '/book/', label: 'Book' },
  { href: '/labs/', label: 'Labs' },
  { href: '/field-notes/', label: 'Field Notes' },
  { href: '/signal/', label: 'Signal' },
  { href: '/recipes/', label: 'Recipes' },
  { href: '/bench/', label: 'Bench' },
  { href: '/evidence/', label: 'Evidence' },
];
---

<header class="topnav">
  <div class="topnav__inner">
    <Brand size="sm" />
    <nav class="topnav__items" aria-label="Primary">
      {items.map((item) => (
        <a
          href={item.href}
          class:list={['topnav__link', current === item.label && 'topnav__link--current']}
          aria-current={current === item.label ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <a class="topnav__subscribe" href="https://agenticlab.substack.com" target="_blank" rel="noopener">Subscribe</a>
  </div>
</header>

<style>
  .topnav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--ink);
    color: var(--paper);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .topnav__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-3) var(--space-5);
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .topnav :global(.brand) { color: var(--paper); }
  .topnav :global(.brand__subtitle) { color: rgba(255, 255, 255, 0.5); }
  .topnav :global(.brand:hover .brand__title) { color: var(--paper); }

  .topnav__items {
    display: flex;
    gap: var(--space-5);
    margin-left: auto;
  }

  .topnav__link {
    font-size: var(--meta-1);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.6);
    padding: var(--space-2) 0;
    border-bottom: 2px solid transparent;
    transition: color var(--dur-micro) var(--ease-out), border-color var(--dur-micro) var(--ease-out);
  }

  .topnav__link:hover { color: var(--paper); }
  .topnav__link--current { color: var(--paper); border-bottom-color: var(--paper); }

  .topnav__subscribe {
    font-size: var(--meta-1);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--paper);
    background: var(--brick);
    padding: var(--space-2) var(--space-4);
    border-radius: 2px;
    white-space: nowrap;
    transition: background var(--dur-micro) var(--ease-out), color var(--dur-micro) var(--ease-out);
  }

  .topnav__subscribe:hover { background: var(--paper); color: var(--ink); }
  .topnav__subscribe:focus-visible { outline: 2px solid var(--paper); outline-offset: 3px; }

  @media (max-width: 720px) {
    .topnav__items { gap: var(--space-3); flex-wrap: wrap; }
    .topnav__subscribe { margin-left: auto; }
  }
</style>

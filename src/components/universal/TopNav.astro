---
/**
 * TopNav — primary navigation.
 * Sticky on scroll. Highlights current section.
 */
import Brand from './Brand.astro';

interface Props {
  current?: string;
}

const { current = '' } = Astro.props;

const items = [
  { href: '/start/', label: 'Start' },
  { href: '/book/', label: 'Book' },
  { href: '/architecture/', label: 'Architecture' },
  { href: '/labs/', label: 'Labs' },
  { href: '/field-notes/', label: 'Field Notes' },
  { href: '/signal/', label: 'Signal' },
  { href: '/recipes/', label: 'Recipes' },
  { href: '/bench/', label: 'Bench' },
  { href: '/evidence/', label: 'Evidence' },
];
---

<header class="topnav">
  <div class="topnav__inner">
    <Brand size="sm" />
    <nav class="topnav__items" aria-label="Primary">
      {items.map((item) => (
        <a
          href={item.href}
          class:list={['topnav__link', current === item.label && 'topnav__link--current']}
          aria-current={current === item.label ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <a class="topnav__subscribe" href="https://agenticlab.substack.com" target="_blank" rel="noopener">Subscribe</a>
  </div>
</header>

<style>
  .topnav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--paper);
    border-bottom: 1px solid var(--ink);
  }

  .topnav__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-3) var(--space-5);
    display: flex;
    align-items: baseline;
    gap: var(--space-6);
  }

  .topnav__items { display: flex; gap: var(--space-5); margin-left: auto; }

  .topnav__link {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--display-4);
    color: #444;
    padding: var(--space-2) 0;
    border-bottom: 2px solid transparent;
    transition: color var(--dur-micro) var(--ease-out), border-color var(--dur-micro) var(--ease-out);
  }

  .topnav__link:hover { color: var(--brick); }
  .topnav__link--current { color: var(--fg); border-bottom-color: var(--brick); }

  .topnav__subscribe {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--display-4);
    color: var(--brick);
    border-bottom: 1.5px solid var(--brick);
    padding-bottom: 2px;
    white-space: nowrap;
    transition: color var(--dur-micro) var(--ease-out);
  }

  .topnav__subscribe:hover { color: var(--ink); border-bottom-color: var(--ink); }
  .topnav__subscribe:focus-visible { outline: 2px solid var(--brick); outline-offset: 3px; }

  @media (max-width: 720px) {
    .topnav__inner {
      flex-wrap: wrap;
      justify-content: space-between;
      row-gap: var(--space-2);
      padding: var(--space-3) var(--space-4);
    }

    .topnav__inner :global(.brand) { order: 1; }

    .topnav__subscribe { order: 2; margin-left: 0; }

    .topnav__items {
      order: 3;
      width: 100%;
      margin-left: 0;
      flex-wrap: nowrap;
      gap: var(--space-4);
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      mask-image: linear-gradient(to right, black calc(100% - 28px), transparent 100%);
      -webkit-mask-image: linear-gradient(to right, black calc(100% - 28px), transparent 100%);
    }

    .topnav__items::-webkit-scrollbar { display: none; }

    .topnav__link {
      font-size: 16px;
      white-space: nowrap;
      flex-shrink: 0;
    }
  }
</style>

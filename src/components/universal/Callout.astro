---
/**
 * Callout — labelled box for gotchas/warnings/tips inside MDX content.
 */
interface Props {
  type?: 'gotcha' | 'warn' | 'tip';
  label?: string;
}

const { type = 'tip', label } = Astro.props;

const defaultLabels: Record<'gotcha' | 'warn' | 'tip', string> = {
  gotcha: 'Gotcha',
  warn: 'Warning',
  tip: 'Tip',
};
const safeType = (type in defaultLabels ? type : 'tip') as keyof typeof defaultLabels;
const displayLabel = label ?? defaultLabels[safeType];
---

<aside class:list={['callout', `callout--${safeType}`]}>
  <div class="callout__label">{displayLabel}</div>
  <div class="callout__body"><slot /></div>
</aside>

<style>
  .callout {
    margin: var(--space-5) 0;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--fg-faint);
    border-left-width: 3px;
    border-radius: var(--radius-md);
    background: var(--paper-recess);
  }

  .callout--gotcha { border-left-color: var(--brick); }
  .callout--warn { border-left-color: var(--brick); }
  .callout--tip { border-left-color: var(--ink); }

  .callout__label {
    font-family: var(--font-mono);
    font-size: var(--meta-3);
    text-transform: uppercase;
    letter-spacing: var(--tracking-loose);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .callout--gotcha .callout__label,
  .callout--warn .callout__label { color: var(--brick); }

  .callout--tip .callout__label { color: var(--fg-light); }

  .callout__body {
    font-size: var(--body-1);
    line-height: var(--lh-base);
  }

  .callout__body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>

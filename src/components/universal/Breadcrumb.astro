---
/**
 * Breadcrumb — chapter / lab / project breadcrumb trail.
 * Format: Book / Part I / Ch 4
 */
interface Crumb {
  label: string;
  href?: string;       // omit on current
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol>
    {items.map((c, i) => (
      <li>
        {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
        {i < items.length - 1 && <span class="breadcrumb__sep" aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumb {
    padding: var(--space-3) 0;
  }

  .breadcrumb ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--meta-2);
    color: var(--fg-light);
  }

  .breadcrumb li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .breadcrumb a {
    color: var(--fg-light);
    transition: color var(--dur-micro) var(--ease-out);
  }

  .breadcrumb a:hover { color: var(--fg); }
  .breadcrumb [aria-current="page"] { color: var(--fg); font-weight: 500; }
  .breadcrumb__sep { color: var(--fg-faint); }
</style>

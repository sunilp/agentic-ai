---
/**
 * Brand — typographic wordmark, Fraunces 900 italic, "Lab" in brick.
 * The ring-gate logo mark lives in the favicon + footer colophon, not here.
 */
interface Props {
  size?: 'sm' | 'md' | 'lg';
}
const { size = 'md' } = Astro.props;
---

<a href="/" class:list={['brand', `brand--${size}`]}>
  <span class="brand__title">Agent Engineering&nbsp;<span class="brand__accent">Lab</span></span>
</a>

<style>
  .brand { display: inline-flex; align-items: baseline; color: var(--fg); text-decoration: none; }

  .brand__title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 900;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .brand__accent { color: var(--brick); }

  .brand--sm .brand__title { font-size: 19px; }
  .brand--md .brand__title { font-size: 24px; }
  .brand--lg .brand__title { font-size: 32px; }

  .brand:hover .brand__accent { color: var(--ink); }
</style>

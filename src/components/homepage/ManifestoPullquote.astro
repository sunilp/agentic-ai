---
/**
 * ManifestoPullquote — homepage band with the brand pullquote + brick-red ink stamp.
 */
import Stamp from '~/components/universal/Stamp.astro';
---

<section class="manifesto-pq">
  <div class="manifesto-pq__inner">
    <Stamp class="manifesto-pq__stamp" width="36px" height="48px" rotation={-3} opacity={0.92} />
    <blockquote class="manifesto-pq__quote">
      "Most agents are workflows in costume. Earn the complexity."
    </blockquote>
    <a class="manifesto-pq__link" href="/agentic-ai/manifesto/">Read the manifesto →</a>
  </div>
</section>

<style>
  .manifesto-pq {
    margin: var(--space-9) 0;
    background: var(--brick-wash);
    padding: var(--space-7) 0;
  }

  .manifesto-pq__inner {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 var(--space-5);
    position: relative;
  }

  .manifesto-pq__stamp {
    position: absolute;
    top: -8px;
    left: var(--space-5);
  }

  .manifesto-pq__quote {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.35;
    color: var(--fg);
    margin: var(--space-5) 0 var(--space-4);
    padding-left: var(--space-5);
    border-left: 2px solid var(--brick);
  }

  .manifesto-pq__link {
    margin-left: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--meta-2);
    text-transform: uppercase;
    letter-spacing: var(--tracking-loose);
    color: var(--brick);
  }
</style>

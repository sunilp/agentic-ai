---
/**
 * ManifestoPullquote — homepage band with the brand pullquote.
 * Centered brick-rule treatment, same pattern as universal/PullQuote.astro.
 */
---

<section class="manifesto-pq">
  <blockquote class="manifesto-pq__quote">
    "Most agents are workflows in costume. Earn the complexity."
  </blockquote>
  <a class="manifesto-pq__link" href="/manifesto/">Read the manifesto →</a>
</section>

<style>
  .manifesto-pq {
    margin: var(--space-9) auto;
    max-width: 780px;
    text-align: center;
    padding: 0 var(--space-5);
  }

  .manifesto-pq__quote {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(23px, 3vw, 29px);
    line-height: 1.45;
    color: var(--fg);
    margin: 0;
    padding: var(--space-5) 0;
    position: relative;
  }

  .manifesto-pq__quote::before,
  .manifesto-pq__quote::after {
    content: '';
    display: block;
    width: 64px;
    height: 3px;
    background: var(--brick);
    margin: 0 auto;
  }

  .manifesto-pq__quote::before { margin-bottom: var(--space-5); }
  .manifesto-pq__quote::after { margin-top: var(--space-5); }

  .manifesto-pq__link {
    display: inline-block;
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--meta-2);
    text-transform: uppercase;
    letter-spacing: var(--tracking-loose);
    color: var(--brick);
  }
</style>

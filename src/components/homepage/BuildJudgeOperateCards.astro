---
/**
 * BuildJudgeOperateCards — homepage three-card row, the mental-model frame.
 * One giant card per book part. Brick-red Part label, Fraunces heading, mini description, link.
 */
const parts = [
  {
    label: 'Part I',
    title: 'Build',
    desc: 'Tools, loops, multi-agent without theater.',
    chapterCount: '4 chapters',
    href: '/book/#part-1',
  },
  {
    label: 'Part II',
    title: 'Judge',
    desc: 'Eval, oversight, when not to use agents.',
    chapterCount: '3 chapters',
    href: '/book/#part-2',
  },
  {
    label: 'Part III',
    title: 'Operate',
    desc: 'Deploy, govern, secure, remember.',
    chapterCount: '6 chapters',
    href: '/book/#part-3',
  },
];
---

<section class="bjo">
  <div class="bjo__grid">
    {parts.map((p) => (
      <a class="bjo__card" href={p.href}>
        <div class="bjo__label">{p.label}</div>
        <h3 class="bjo__title">{p.title}</h3>
        <p class="bjo__desc">{p.desc}</p>
        <div class="bjo__cta">{p.chapterCount} →</div>
      </a>
    ))}
  </div>
</section>

<style>
  .bjo { margin: var(--space-7) 0; border-top: 3px solid var(--ink); }
  .bjo__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; }
  .bjo__card {
    display: flex; flex-direction: column; padding: var(--space-5) var(--space-5) var(--space-5) 0;
    border: 0; border-right: 1px solid var(--fg-faint); color: var(--fg); background: transparent;
  }
  .bjo__card:last-child { border-right: 0; }
  .bjo__card + .bjo__card { padding-left: var(--space-5); }
  .bjo__label {
    font-family: var(--font-mono); font-size: var(--meta-3);
    text-transform: uppercase; letter-spacing: var(--tracking-loose); color: var(--brick);
  }
  .bjo__title {
    font-family: var(--font-display); font-weight: 900; font-size: clamp(24px, 2.6vw, 32px);
    margin: var(--space-2) 0; letter-spacing: var(--tracking-tight);
  }
  .bjo__card:hover .bjo__title { color: var(--brick); }
  .bjo__desc { font-family: var(--font-body); color: #3c3c3a; font-size: var(--display-4); line-height: var(--lh-snug); margin: 0 0 var(--space-4); flex: 1; }
  .bjo__cta { font-family: var(--font-body); font-style: italic; font-size: var(--body-2); color: var(--brick); }
  @media (max-width: 720px) {
    .bjo__grid { grid-template-columns: 1fr; }
    .bjo__card { border-right: 0; border-bottom: 1px solid var(--fg-faint); padding-left: 0; }
  }
</style>

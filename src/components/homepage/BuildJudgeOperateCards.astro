---
/**
 * BuildJudgeOperateCards — homepage three-card row, the mental-model frame.
 * One giant card per book part. Brick-red Part label, Fraunces heading, mini description, link.
 */
const parts = [
  {
    label: 'Part I',
    title: 'Build',
    desc: 'Tools, loops, multi-agent without theater.',
    chapterCount: '4 chapters',
    href: '/agentic-ai/book/#part-1',
  },
  {
    label: 'Part II',
    title: 'Judge',
    desc: 'Eval, oversight, when not to use agents.',
    chapterCount: '3 chapters',
    href: '/agentic-ai/book/#part-2',
  },
  {
    label: 'Part III',
    title: 'Operate',
    desc: 'Deploy, govern, secure, remember.',
    chapterCount: '6 chapters',
    href: '/agentic-ai/book/#part-3',
  },
];
---

<section class="bjo">
  <div class="bjo__grid">
    {parts.map((p) => (
      <a class="bjo__card" href={p.href}>
        <div class="bjo__label">{p.label}</div>
        <h3 class="bjo__title">{p.title}</h3>
        <p class="bjo__desc">{p.desc}</p>
        <div class="bjo__cta">{p.chapterCount} →</div>
      </a>
    ))}
  </div>
</section>

<style>
  .bjo { margin: var(--space-7) 0; }

  .bjo__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .bjo__card {
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    border: 1px solid var(--ink);
    background: var(--paper);
    color: var(--fg);
    transition: transform var(--dur-micro) var(--ease-out), box-shadow var(--dur-micro) var(--ease-out);
  }

  .bjo__card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
  }

  .bjo__label {
    font-family: var(--font-mono);
    font-size: var(--meta-3);
    text-transform: uppercase;
    letter-spacing: var(--tracking-loose);
    color: var(--brick);
  }

  .bjo__title {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.5vw, 32px);
    font-weight: 500;
    margin: var(--space-2) 0;
    letter-spacing: var(--tracking-tight);
  }

  .bjo__desc {
    color: var(--fg-light);
    font-size: var(--body-2);
    line-height: var(--lh-snug);
    margin: 0 0 var(--space-4);
    flex: 1;
  }

  .bjo__cta {
    font-family: var(--font-mono);
    font-size: var(--meta-2);
    color: var(--brick);
    letter-spacing: 0.02em;
  }

  @media (max-width: 720px) {
    .bjo__grid { grid-template-columns: 1fr; }
  }
</style>

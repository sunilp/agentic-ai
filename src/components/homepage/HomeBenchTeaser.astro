---
/**
 * HomeBenchTeaser — framed Gallery band pointing to the interactive Bench.
 */
---

<section class="bench-teaser">
  <div class="bench-teaser__inner">
    <div>
      <h3 class="bench-teaser__title">The Bench</h3>
      <p class="bench-teaser__copy">Read the argument, then run it. Interactive experiments in the browser, no setup. Start with Loop Lab: toggle the fences and watch an agent either delete production or get stopped.</p>
    </div>
    <a class="bench-teaser__cta" href="/bench/">Run the Loop Lab →</a>
  </div>
</section>

<style>
  .bench-teaser { margin: var(--space-8) 0; }
  .bench-teaser__inner {
    border: 1px solid var(--ink);
    padding: var(--space-6) var(--space-6);
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-6);
  }
  .bench-teaser__title {
    font-family: var(--font-display); font-style: italic; font-weight: 900;
    font-size: clamp(22px, 2.6vw, 26px); margin: 0 0 var(--space-2);
  }
  .bench-teaser__copy { margin: 0; font-family: var(--font-body); color: #3c3c3a; font-size: var(--display-4); line-height: var(--lh-base); max-width: 56ch; }
  .bench-teaser__cta {
    flex-shrink: 0; font-family: var(--font-display); font-weight: 600; font-size: var(--display-4);
    color: var(--brick); border-bottom: 2px solid var(--brick); padding-bottom: 3px; white-space: nowrap;
  }
  .bench-teaser__cta:hover { color: var(--ink); border-bottom-color: var(--ink); }
  @media (max-width: 600px) { .bench-teaser__inner { flex-direction: column; align-items: flex-start; } }
</style>

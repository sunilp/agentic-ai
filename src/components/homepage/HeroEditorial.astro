---
/**
 * HeroEditorial — Gallery homepage hero. Poster Fraunces + dek with drop cap + spot.
 */
import Spot from '~/components/universal/Spot.astro';
---

<section class="hero">
  <div class="hero__text">
    <h1 class="hero__title">Build agents that <em>survive contact</em> with reality.</h1>
    <p class="hero__dek">Most agents are workflows in costume. Reliability lives in the harness, the loop, and the gate, not the model. This lab publishes the evidence.</p>
    <div class="hero__ctas">
      <a href="/start/" class="hero__cta hero__cta--primary">Start here</a>
      <a href="/book/" class="hero__cta">Read the book</a>
      <a href="/evidence/" class="hero__cta">The evidence</a>
    </div>
  </div>
  <div class="hero__art"><Spot src="/assets/spots/home-hero.png" alt="An engraved tightrope walker heading toward a brick-red sun" size="article" eager /></div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: var(--space-7);
    align-items: center;
    padding: var(--space-8) 0 var(--space-6);
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--display-poster);
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  .hero__title em { font-style: italic; font-weight: 600; color: var(--brick); }

  .hero__dek {
    margin-top: var(--space-5);
    font-family: var(--font-body);
    font-size: var(--dek-size);
    line-height: 1.55;
    color: #3c3c3a;
    max-width: 46ch;
  }

  .hero__dek::first-letter {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 2.6em;
    color: var(--brick);
    float: left;
    line-height: 0.85;
    padding: 0.05em 0.14em 0 0;
  }

  .hero__ctas { margin-top: var(--space-5); display: flex; gap: var(--space-5); align-items: baseline; flex-wrap: wrap; }

  .hero__cta {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--display-4);
    color: var(--fg);
    border-bottom: 2px solid var(--brick);
    padding-bottom: 3px;
  }

  .hero__cta:hover { color: var(--brick); }

  .hero__cta--primary {
    background: var(--ink);
    color: var(--paper);
    border-bottom: 0;
    padding: var(--space-3) var(--space-5);
  }

  .hero__cta--primary:hover { background: var(--brick); color: var(--paper); }

  .hero__art { text-align: center; }

  @media (max-width: 820px) {
    .hero { grid-template-columns: 1fr; }
    .hero__art { order: -1; }
    .hero__art :global(svg) { width: 200px; height: auto; }
  }
</style>

---
/**
 * HeroEditorial: homepage hero. One line in light Fraunces, a plain dek, and the engraving.
 */
import Spot from '~/components/universal/Spot.astro';
---

<section class="hero">
  <div class="hero__text">
    <h1 class="hero__title">Build agents that survive contact with reality.</h1>
    <p class="hero__dek">Most agents are workflows in costume. Reliability lives in the harness, the loop, and the gate, not the model. This lab publishes the evidence.</p>
    <div class="hero__ctas">
      <a href="/start/" class="hero__cta hero__cta--primary">Start here</a>
      <a href="/book/" class="hero__cta">Read the book</a>
      <a href="/evidence/" class="hero__cta">The evidence</a>
    </div>
  </div>
  <div class="hero__art"><Spot src="/assets/spots/home-hero.png" alt="An engraved tightrope walker heading toward a brick-red sun" size="article" eager /></div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: var(--space-7);
    align-items: center;
    padding: var(--space-8) 0 var(--space-7);
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(40px, 5.6vw, 68px);
    line-height: 1.04;
    font-variation-settings: 'opsz' 144;
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  .hero__dek {
    margin-top: var(--space-5);
    font-family: var(--font-body);
    font-size: var(--dek-size);
    line-height: 1.55;
    color: #3c3c3a;
    max-width: 44ch;
  }

  .hero__ctas { margin-top: var(--space-5); display: flex; gap: var(--space-5); align-items: baseline; flex-wrap: wrap; }

  .hero__cta {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--display-4);
    color: var(--fg);
    border-bottom: 2px solid var(--brick);
    padding-bottom: 3px;
  }

  .hero__cta:hover { color: var(--brick); }

  .hero__cta--primary {
    background: var(--ink);
    color: var(--paper);
    border-bottom: 0;
    padding: var(--space-3) var(--space-5);
  }

  .hero__cta--primary:hover { background: var(--brick); color: var(--paper); }

  .hero__art { text-align: center; }
  /* The engraving's own ground is a shade off the page; multiply lets the paper show through it. */
  .hero__art :global(.spot__img) {
    mix-blend-mode: multiply;
    -webkit-mask-image: radial-gradient(ellipse 62% 62% at 50% 50%, #000 62%, transparent 100%);
    mask-image: radial-gradient(ellipse 62% 62% at 50% 50%, #000 62%, transparent 100%);
  }

  @media (max-width: 820px) {
    .hero { grid-template-columns: 1fr; padding-top: var(--space-6); }
    .hero__art :global(.spot__img) { max-width: 62%; }
  }
</style>

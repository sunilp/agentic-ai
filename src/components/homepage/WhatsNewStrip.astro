---
/**
 * WhatsNewStrip — 3 latest publications card row.
 * Dynamically loads from Content Collections (fieldNotes + recipes + labs)
 * and shows the 3 most recent by date.
 */
import { getCollection } from 'astro:content';
import EntryCard from '~/components/universal/EntryCard.astro';

interface CardItem {
  kicker: string;
  title: string;
  href: string;
  image?: string;
  date: Date;
}

const [fns, recipes, labs] = await Promise.all([
  getCollection('fieldNotes'),
  getCollection('recipes'),
  getCollection('labs'),
]);

const items: CardItem[] = [
  ...fns.map((e) => ({
    kicker: `${e.data.id.toUpperCase()} · Field Note`,
    title: e.data.title,
    href: `/field-notes/${e.id}/`,
    image: e.data.spot,
    date: e.data.date,
  })),
  ...recipes.map((e) => ({
    kicker: `${e.data.id.toUpperCase()} · Recipe`,
    title: e.data.title,
    href: `/recipes/${e.id}/`,
    image: e.data.spot,
    date: e.data.verifiedOn,
  })),
  ...labs.map((e) => ({
    kicker: `${e.data.id.toUpperCase()} · Lab`,
    title: e.data.title,
    href: `/labs/${e.id}/`,
    image: e.data.spot,
    date: e.data.date,
  })),
];

const top3 = items.sort((a, b) => b.date.getTime() - a.date.getTime()).slice(0, 3);
---

<section class="whats-new">
  <header class="whats-new__header">
    <div class="whats-new__label">What's new</div>
    <a class="whats-new__see-all" href="/field-notes/">See all →</a>
  </header>

  {top3.length === 0 ? (
    <p class="whats-new__empty">No recent issues yet.</p>
  ) : (
    <div class="whats-new__grid">
      {top3.map((item) => (
        <EntryCard
          href={item.href}
          rubric={item.kicker.toUpperCase()}
          title={item.title}
          image={item.image}
          imageKind="spot"
        />
      ))}
    </div>
  )}
</section>

<style>
  .whats-new { margin: var(--space-7) 0; }

  .whats-new__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-4);
  }

  .whats-new__label {
    font-family: var(--font-mono);
    font-size: var(--meta-3);
    letter-spacing: var(--tracking-rubric);
    text-transform: uppercase;
    color: var(--brick);
  }

  .whats-new__see-all {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--body-2);
    color: var(--fg);
  }

  .whats-new__see-all:hover { color: var(--brick); }

  .whats-new__empty {
    color: var(--fg-light);
    font-style: italic;
  }

  .whats-new__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  @media (max-width: 720px) {
    .whats-new__grid { grid-template-columns: 1fr; }
  }
</style>

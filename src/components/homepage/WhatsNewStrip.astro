---
/**
 * WhatsNewStrip — 3 latest publications card row.
 * Dynamically loads from Content Collections (fieldNotes + recipes + labs)
 * and shows the 3 most recent by date.
 */
import { getCollection } from 'astro:content';

interface CardItem {
  kicker: string;
  title: string;
  href: string;
  banner: string;
  bannerAlt: string;
  date: Date;
}

const [fns, recipes, labs] = await Promise.all([
  getCollection('fieldNotes'),
  getCollection('recipes'),
  getCollection('labs'),
]);

const items: CardItem[] = [
  ...fns.map((e) => ({
    kicker: `${e.data.id.toUpperCase()} · Field Note`,
    title: e.data.title,
    href: `/field-notes/${e.id}/`,
    banner: e.data.banner,
    bannerAlt: `${e.data.title} banner`,
    date: e.data.date,
  })),
  ...recipes.map((e) => ({
    kicker: `${e.data.id.toUpperCase()} · Recipe`,
    title: e.data.title,
    href: `/recipes/${e.id}/`,
    banner: `/assets/banners/${e.data.id}.png`,
    bannerAlt: `${e.data.title} banner`,
    date: e.data.verifiedOn,
  })),
  ...labs.map((e) => ({
    kicker: `${e.data.id.toUpperCase()} · Lab`,
    title: e.data.title,
    href: `/labs/${e.id}/`,
    banner: `/assets/banners/${e.data.id}.png`,
    bannerAlt: `${e.data.title} banner`,
    date: e.data.date,
  })),
];

const top3 = items.sort((a, b) => b.date.getTime() - a.date.getTime()).slice(0, 3);
---

<section class="whats-new">
  <header class="whats-new__header">
    <div class="whats-new__label">What's new</div>
    <a class="whats-new__see-all" href="/field-notes/">See all →</a>
  </header>

  {top3.length === 0 ? (
    <p class="whats-new__empty">No recent issues yet.</p>
  ) : (
    <div class="whats-new__grid">
      {top3.map((item) => (
        <a class="whats-new__card" href={item.href}>
          <img src={item.banner} alt={item.bannerAlt} class="whats-new__banner" loading="lazy" width="600" height="315" />
          <div class="whats-new__kicker">{item.kicker}</div>
          <h3 class="whats-new__title">{item.title}</h3>
        </a>
      ))}
    </div>
  )}
</section>

<style>
  .whats-new { margin: var(--space-7) 0; }

  .whats-new__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-4);
  }

  .whats-new__label {
    font-family: var(--font-mono);
    font-size: var(--meta-2);
    text-transform: uppercase;
    letter-spacing: var(--tracking-loose);
    color: var(--fg-light);
  }

  .whats-new__see-all {
    font-family: var(--font-mono);
    font-size: var(--meta-2);
    text-transform: uppercase;
    letter-spacing: var(--tracking-loose);
    color: var(--brick);
  }

  .whats-new__empty {
    color: var(--fg-light);
    font-style: italic;
  }

  .whats-new__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .whats-new__card {
    color: var(--fg);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: transform var(--dur-micro) var(--ease-out);
  }

  .whats-new__card:hover { transform: translateY(-2px); }

  .whats-new__banner {
    width: 100%;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    background: var(--paper-recess);
    border: 1px solid var(--fg-faint);
    border-radius: var(--radius-sm);
  }

  .whats-new__kicker {
    font-family: var(--font-mono);
    font-size: var(--meta-3);
    text-transform: uppercase;
    letter-spacing: var(--tracking-loose);
    color: var(--brick);
  }

  .whats-new__title {
    font-family: var(--font-display);
    font-size: var(--display-3);
    line-height: var(--lh-snug);
    font-weight: 500;
    margin: 0;
    color: var(--fg);
  }

  @media (max-width: 720px) {
    .whats-new__grid { grid-template-columns: 1fr; }
  }
</style>

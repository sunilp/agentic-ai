---
/**
 * EvidenceInlineStrip — one-line ruled evidence row. Static numbers
 * (rendered server-side; the old count-up script left zeros when it failed).
 * Numbers come from LAB-001 published results.
 */
interface Stat { value: string; label: string; }
interface Props { stats?: Stat[]; }

const defaultStats: Stat[] = [
  { value: '+3.4pp', label: 'Workflow beat agent' },
  { value: '2.4×', label: 'Agent cost' },
  { value: '2.2×', label: 'Agent latency' },
];
const { stats = defaultStats } = Astro.props;
---

<section class="evidence-strip" aria-label="Evidence at a glance">
  <a class="evidence-strip__inner" href="/evidence/">
    {stats.map((stat) => (
      <span class="evidence-strip__stat">
        <span class="evidence-strip__value">{stat.value}</span>
        <span class="evidence-strip__label">{stat.label}</span>
      </span>
    ))}
    <span class="evidence-strip__cta">See the evidence →</span>
  </a>
</section>

<style>
  .evidence-strip { border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); margin: var(--space-3) 0 var(--space-7); }
  .evidence-strip__inner {
    display: flex; flex-wrap: wrap; align-items: baseline; justify-content: center;
    gap: var(--space-3) var(--space-7); padding: var(--space-4) 0; color: var(--fg); text-decoration: none;
  }
  .evidence-strip__stat { display: inline-flex; align-items: baseline; gap: var(--space-2); }
  .evidence-strip__value { font-family: var(--font-display); font-weight: 600; font-size: var(--display-3); color: var(--brick); }
  .evidence-strip__label {
    font-family: var(--font-mono); font-size: var(--meta-3);
    text-transform: uppercase; letter-spacing: var(--tracking-loose); color: var(--fg-light);
  }
  .evidence-strip__cta { font-family: var(--font-body); font-style: italic; font-size: var(--body-2); color: var(--brick); }
  .evidence-strip__inner:hover .evidence-strip__cta { color: var(--ink); }
</style>

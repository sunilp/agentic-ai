---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import PageLayout from './PageLayout.astro';
import Container from '~/components/layout/Container.astro';
import Split from '~/components/layout/Split.astro';
import MetaStrip from '~/components/universal/MetaStrip.astro';
import KineticHeading from '~/components/universal/KineticHeading.astro';
import Dek from '~/components/universal/Dek.astro';
import Tag from '~/components/universal/Tag.astro';
import Breadcrumb from '~/components/universal/Breadcrumb.astro';
import ProgressReader from '~/components/universal/ProgressReader.astro';
import ChapterMap from '~/components/universal/ChapterMap.astro';
import NextPrev from '~/components/universal/NextPrev.astro';
import { buildReverseIndex, getReverseLinks } from '~/lib/cross-links';
import { entriesToContentEntries } from '~/lib/content-helpers';

interface Props {
  entry: CollectionEntry<'chapters'>;
}

const { entry } = Astro.props;
const d = entry.data;

const [chapters, fieldNotes, recipes, labs, evidence, projects, patterns, signal] = await Promise.all([
  getCollection('chapters'),
  getCollection('fieldNotes'),
  getCollection('recipes'),
  getCollection('labs'),
  getCollection('evidence'),
  getCollection('projects'),
  getCollection('patterns'),
  getCollection('signal'),
]);
const allEntries = [...chapters, ...fieldNotes, ...recipes, ...labs, ...evidence, ...projects, ...patterns, ...signal];
const reverseIndex = buildReverseIndex(entriesToContentEntries(allEntries as any));
const links = getReverseLinks(reverseIndex, entry.id);

// Find prev/next by filename sort order.
const sortedChapters = [...chapters].sort((a, b) => a.id.localeCompare(b.id));
const currentIdx = sortedChapters.findIndex((c) => c.id === entry.id);
const prev = currentIdx > 0 ? sortedChapters[currentIdx - 1] : null;
const next = currentIdx < sortedChapters.length - 1 ? sortedChapters[currentIdx + 1] : null;

const partLabels: Record<string, string> = {
  'foundations': 'Foundations',
  'I-build': 'Part I · Build',
  'II-judge': 'Part II · Judge',
  'III-operate': 'Part III · Operate',
  'IV-advanced': 'Part IV · Advanced',
};
const partLabel = partLabels[d.part] ?? d.part;

const chapterPrefix = entry.id.split('-')[0].toUpperCase();
const dateStr = d.date.toISOString().slice(0, 10);
const metaItems = [chapterPrefix, dateStr, `${d.readingTime} min`];

const collectionRoute: Record<string, string> = {
  chapters: '/book',
  fieldNotes: '/field-notes',
  recipes: '/recipes',
  projects: '/projects',
  evidence: '/evidence',
  labs: '/labs',
  patterns: '/patterns',
  signal: '/signal',
};
---

<PageLayout
  title={`${d.title} — ${partLabel}`}
  description={d.description}
  currentNav="Book"
>
  <ProgressReader />

  <Container>
    <Breadcrumb
      items={[
        { label: 'Book', href: '/book/' },
        { label: partLabel, href: `/book/#${d.part}` },
        { label: chapterPrefix },
      ]}
    />

    <Split ratio="3:1" gap="var(--space-7)">
      <article class="chapter-main">
        <Tag>{partLabel}</Tag>
        <MetaStrip items={metaItems} />
        <KineticHeading level={1}>{d.title}</KineticHeading>
        <Dek italic>{d.description}</Dek>

        <div class="chapter-body prose prose--dropcap">
          <slot />
        </div>

        <NextPrev
          prev={prev ? { slug: prev.id, title: prev.data.title } : undefined}
          next={next ? { slug: next.id, title: next.data.title } : undefined}
        />

        {(links.referencedBy.length > 0 || links.citedBy.length > 0) && (
          <section class="chapter-cited-by">
            <h2>Referenced by</h2>
            <ul>
              {[...links.referencedBy, ...links.citedBy].map((l) => (
                <li><a href={`${collectionRoute[l.collection] ?? ''}/${l.id}/`}>{l.collection}/{l.id}</a></li>
              ))}
            </ul>
          </section>
        )}
      </article>

      <aside class="chapter-sidebar">
        <ChapterMap currentSlug={entry.id} />
      </aside>
    </Split>
  </Container>
</PageLayout>

<style>
  .chapter-main {
    max-width: 720px;
  }

  /* Headings are potential hash-link targets (footnotes, cross-refs); keep
     the offset so the sticky TopNav doesn't cover them. */
  .chapter-body :global(h2) {
    scroll-margin-top: 80px;
  }

  /* `.prose` in selector provides deterministic specificity headroom over prose.css */
  .chapter-body.prose :global(blockquote) {
    border-left: 2px solid var(--ink);
    padding-left: var(--space-4);
    margin: var(--space-5) 0;
    color: var(--fg-light);
    font-style: normal;
  }

  .chapter-body :global(pre) {
    margin: var(--space-4) 0;
  }

  /* `.prose` in selector provides deterministic specificity headroom over prose.css */
  .chapter-body.prose :global(table) {
    border-collapse: collapse;
    margin: var(--space-4) 0;
    font-size: var(--body-2);
    width: 100%;
  }

  /* `.prose` in selector provides deterministic specificity headroom over prose.css */
  .chapter-body.prose :global(th),
  .chapter-body.prose :global(td) {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--fg-faint);
    text-align: left;
    vertical-align: top;
  }

  /* `.prose` in selector provides deterministic specificity headroom over prose.css */
  .chapter-body.prose :global(th) {
    background: var(--paper-recess);
    font-family: var(--font-mono);
    font-size: var(--meta-2);
    text-transform: uppercase;
    letter-spacing: var(--tracking-loose);
  }

  .chapter-sidebar {
    position: sticky;
    top: 80px;
    align-self: flex-start;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
  }

  .chapter-cited-by {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--fg-faint);
  }

  .chapter-cited-by h2 {
    font-family: var(--font-mono);
    font-size: var(--meta-2);
    text-transform: uppercase;
    letter-spacing: var(--tracking-loose);
    color: var(--fg-light);
  }

  .chapter-cited-by ul { list-style: none; padding: 0; }
  .chapter-cited-by a { font-family: var(--font-mono); font-size: var(--body-3); color: var(--fg); }

  @media (max-width: 720px) {
    .chapter-sidebar { display: none; }
  }
</style>

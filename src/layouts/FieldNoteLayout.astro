---
import type { CollectionEntry } from 'astro:content';
import PageLayout from './PageLayout.astro';
import Reader from '~/components/layout/Reader.astro';
import MetaStrip from '~/components/universal/MetaStrip.astro';
import KineticHeading from '~/components/universal/KineticHeading.astro';
import Dek from '~/components/universal/Dek.astro';
import Banner from '~/components/universal/Banner.astro';
import Sources from '~/components/universal/Sources.astro';

interface Props {
  entry: CollectionEntry<'fieldNotes'>;
}

const { entry } = Astro.props;
const d = entry.data;

const dateStr = d.date.toISOString().slice(0, 10);
const chapterLabel = d.primaryChapter.startsWith('ch-')
  ? `Ch ${parseInt(d.primaryChapter.slice(3), 10)}`
  : d.primaryChapter;
const metaItems = [d.id.toUpperCase(), dateStr, `${d.readingTime} min`, chapterLabel];
---

<PageLayout
  title={`${d.title} — Field Notes`}
  description={d.description}
  ogImage={d.banner}
  currentNav="Field Notes"
>
  <Reader>
    <MetaStrip items={metaItems} />
    <KineticHeading level={1}>{d.title}</KineticHeading>
    <Dek italic>{d.dek}</Dek>
    <Banner src={d.banner} alt={`${d.title} banner illustration`} />
    <article class="fn-body">
      <slot />
    </article>
    <Sources items={d.sources} />
  </Reader>
</PageLayout>

<style>
  .fn-body {
    font-size: var(--body-1);
    line-height: var(--lh-base);
  }

  .fn-body :global(h2) {
    margin-top: var(--space-7);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--fg-faint);
  }

  .fn-body :global(h3) {
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
  }

  .fn-body :global(p) {
    margin: 0 0 var(--space-4);
  }

  .fn-body :global(ul),
  .fn-body :global(ol) {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-5);
  }

  .fn-body :global(li) {
    margin-bottom: var(--space-2);
  }

  .fn-body :global(a) {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--fg-faint);
    text-underline-offset: 3px;
  }

  .fn-body :global(a:hover) {
    color: var(--brick);
    text-decoration-color: var(--brick);
  }

  .fn-body :global(figure) {
    margin: var(--space-5) 0;
  }

  .fn-body :global(figure img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    border: 1px solid var(--fg-faint);
  }

  .fn-body :global(figcaption) {
    font-family: var(--font-mono);
    font-size: var(--meta-2);
    color: var(--fg-light);
    margin-top: var(--space-2);
    text-align: center;
  }
</style>

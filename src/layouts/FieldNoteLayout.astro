---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import PageLayout from './PageLayout.astro';
import Reader from '~/components/layout/Reader.astro';
import ArticleHeader from '~/components/universal/ArticleHeader.astro';
import Spot from '~/components/universal/Spot.astro';
import Sources from '~/components/universal/Sources.astro';
import { buildReverseIndex, getReverseLinks } from '~/lib/cross-links';
import { entriesToContentEntries } from '~/lib/content-helpers';

interface Props {
  entry: CollectionEntry<'fieldNotes'>;
}

const { entry } = Astro.props;
const d = entry.data;

const [chapters, fieldNotes, recipes, labs, evidence, projects, signal] = await Promise.all([
  getCollection('chapters'),
  getCollection('fieldNotes'),
  getCollection('recipes'),
  getCollection('labs'),
  getCollection('evidence'),
  getCollection('projects'),
  getCollection('signal'),
]);
const allEntries = [
  ...chapters, ...fieldNotes, ...recipes, ...labs, ...evidence, ...projects, ...signal,
];
const reverseIndex = buildReverseIndex(entriesToContentEntries(allEntries as any));
const links = getReverseLinks(reverseIndex, d.id);
const hasReverseLinks = links.referencedBy.length > 0 || links.citedBy.length > 0;

const collectionRoute: Record<string, string> = {
  chapters: '/book',
  fieldNotes: '/field-notes',
  recipes: '/recipes',
  projects: '/projects',
  evidence: '/evidence',
  labs: '/labs',
  patterns: '/patterns',
  signal: '/signal',
};

function linkHref(l: { id: string; collection: string }): string {
  const base = collectionRoute[l.collection] ?? `/${l.collection}`;
  return `${base}/${l.id}/`;
}

function linkLabel(l: { id: string; collection: string }): string {
  // Use uppercase ID for ids that look like 'fn-001', 'r-001', 'lab-001', etc.
  // For chapter slugs like '04-multi-agent-without-theater', show 'Ch 4'.
  const m = l.id.match(/^(\d+)([a-z]?)-/);
  if (m && l.collection === 'chapters') {
    return `Ch ${parseInt(m[1], 10)}${m[2].toUpperCase()}`;
  }
  return l.id.toUpperCase();
}

const chapterLabel = d.primaryChapter.startsWith('ch-')
  ? `Ch ${parseInt(d.primaryChapter.slice(3), 10)}`
  : d.primaryChapter;
const dateLong = d.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).toUpperCase();
const byline = ['SUNIL PRAKASH', dateLong, `${d.readingTime} MIN`, chapterLabel.toUpperCase()];
---

<PageLayout
  title={`${d.title} — Field Notes`}
  description={d.description}
  ogImage={d.banner}
  currentNav="Field Notes"
  articleData={{
    publishedTime: d.date.toISOString(),
    section: 'Field Notes',
    headline: d.title,
  }}
>
  <Reader>
    <ArticleHeader rubric={`FIELD NOTE · ${d.id.toUpperCase()}`} title={d.title} dek={d.dek} byline={byline} />
    {d.spot && <Spot src={d.spot} alt={d.spotCaption ?? ''} caption={d.spotCaption} />}
    <article class="fn-body prose prose--dropcap">
      <slot />
    </article>
    <Sources items={d.sources} />
    {hasReverseLinks && (
      <section class="fn-referenced-by">
        <h2 class="fn-referenced-by__heading">Cited by</h2>
        <ul class="fn-referenced-by__list">
          {[...links.referencedBy, ...links.citedBy].map((l) => (
            <li>
              <a href={linkHref(l)} class="fn-referenced-by__link">
                <span class="fn-referenced-by__collection">{l.collection}</span>
                <span class="fn-referenced-by__id">{linkLabel(l)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </Reader>
</PageLayout>

<style>
  .fn-referenced-by {
    margin-top: var(--space-6);
  }

  .fn-referenced-by__heading {
    font-family: var(--font-mono);
    font-size: var(--meta-2);
    text-transform: uppercase;
    letter-spacing: var(--tracking-loose);
    color: var(--fg-light);
    margin: 0 0 var(--space-3);
    font-weight: 500;
  }

  .fn-referenced-by__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .fn-referenced-by__link {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--fg-faint);
    text-underline-offset: 3px;
    transition: color var(--dur-micro) var(--ease-out);
  }

  .fn-referenced-by__link:hover {
    color: var(--brick);
    text-decoration-color: var(--brick);
  }

  .fn-referenced-by__collection {
    font-family: var(--font-mono);
    font-size: var(--meta-3);
    text-transform: uppercase;
    letter-spacing: var(--tracking-loose);
    color: var(--fg-light);
  }

  .fn-referenced-by__id {
    font-family: var(--font-mono);
    font-size: var(--body-3);
  }
</style>

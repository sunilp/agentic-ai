---
/**
 * PageLayout — base HTML scaffold used by every page.
 * Includes <head> with fonts/global CSS, TopNav, SiteFooter, ClientRouter for View Transitions.
 */
import { ClientRouter } from 'astro:transitions';
import TopNav from '~/components/universal/TopNav.astro';
import SiteFooter from '~/components/universal/SiteFooter.astro';
import CommandPalette from '~/components/islands/CommandPalette.svelte';
import '~/styles/global.css';

interface ArticleData {
  publishedTime: string;   // ISO 8601 date string
  section: string;         // e.g. "Field Notes", "Signal", "Recipes"
  headline?: string;       // overrides title for schema.org headline if title includes section suffix
}

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  currentNav?: string;     // matches TopNav `current` prop
  bodyClass?: string;
  articleData?: ArticleData;
}

const { title, description, ogImage, currentNav, bodyClass, articleData } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const absoluteOgImage = ogImage ? new URL(ogImage, Astro.site).toString() : undefined;

const articleSchema = articleData ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: articleData.headline ?? title,
  description: description,
  image: absoluteOgImage,
  datePublished: articleData.publishedTime,
  articleSection: articleData.section,
  author: {
    '@type': 'Person',
    name: 'Sunil Prakash',
    url: 'https://sunilprakash.com',
    sameAs: [
      'https://www.linkedin.com/in/sunilprakash',
      'https://github.com/sunilp',
      'https://x.com/_sunilp',
      'https://scholar.google.com/citations?user=RdrGjZQAAAAJ',
      'https://orcid.org/0000-0002-6670-1155',
    ],
  },
  publisher: {
    '@type': 'Person',
    name: 'Sunil Prakash',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL,
  },
} : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="alternate" type="application/rss+xml" title="Agentic AI for Serious Engineers" href="/rss.xml" />

    <meta property="og:type" content={articleData ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonicalURL} />
    {description && <meta property="og:description" content={description} />}
    {absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    {articleData && (
      <>
        <meta property="article:published_time" content={articleData.publishedTime} />
        <meta property="article:author" content="Sunil Prakash" />
        <meta property="article:section" content={articleData.section} />
      </>
    )}

    {articleSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    )}

    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-4KDCBS18GZ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-4KDCBS18GZ');
      document.addEventListener('astro:page-load', () => {
        gtag('config', 'G-4KDCBS18GZ', { page_path: window.location.pathname + window.location.search });
      });
    </script>

    <ClientRouter />
  </head>
  <body class={bodyClass}>
    <a href="#main-content" class="skip-nav">Skip to content</a>
    <TopNav current={currentNav} />
    <CommandPalette client:idle />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .skip-nav {
    position: absolute;
    left: -9999px;
    top: 0;
    padding: var(--space-3) var(--space-5);
    background: var(--ink);
    color: var(--paper);
    z-index: 200;
    font-family: var(--font-mono);
    font-size: var(--meta-1);
    text-transform: uppercase;
    letter-spacing: var(--tracking-loose);
  }

  .skip-nav:focus {
    left: 0;
  }

  main {
    flex: 1;
  }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
</style>

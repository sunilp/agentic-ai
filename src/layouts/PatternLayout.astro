---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import PageLayout from './PageLayout.astro';
import Container from '~/components/layout/Container.astro';
import Reader from '~/components/layout/Reader.astro';
import KineticHeading from '~/components/universal/KineticHeading.astro';
import Dek from '~/components/universal/Dek.astro';
import Tag from '~/components/universal/Tag.astro';
import PatternCard from '~/components/universal/PatternCard.astro';
import ArchitectureDiagram from '~/components/universal/ArchitectureDiagram.astro';
import Sources from '~/components/universal/Sources.astro';
import { buildReverseIndex, getReverseLinks } from '~/lib/cross-links';
import { entriesToContentEntries } from '~/lib/content-helpers';
import { bySlug } from '~/data/pattern-language';

interface Props {
  entry: CollectionEntry<'patterns'>;
}

const { entry } = Astro.props;
const d = entry.data;
const meta = bySlug(entry.id);
if (!meta) throw new Error(`No pattern-language entry for ${entry.id}`);

const [chapters, fieldNotes, recipes, labs, evidence, projects, patterns, architecture] = await Promise.all([
  getCollection('chapters'),
  getCollection('fieldNotes'),
  getCollection('recipes'),
  getCollection('labs'),
  getCollection('evidence'),
  getCollection('projects'),
  getCollection('patterns'),
  getCollection('architecture'),
]);
const allEntries = [...chapters, ...fieldNotes, ...recipes, ...labs, ...evidence, ...projects, ...patterns];
// Architecture entries carry a frontmatter `id` (e.g. `arch-001`) distinct from
// their collection id (the filename, e.g. `001-the-control-plane`), and routes are
// built from the filename. entriesToContentEntries falls back to entry.id only when
// data.id is absent, so feeding architecture through it would key + link every
// mention by the frontmatter id and 404. Map architecture entries by hand instead,
// keyed by the filename, so "Used in" links land on the real blueprint route.
const architectureAsEntries = architecture.map((a) => ({
  id: a.id,
  collection: a.collection,
  patterns: a.data.patterns,
}));
const reverseIndex = buildReverseIndex([...entriesToContentEntries(allEntries as any), ...architectureAsEntries]);
// Patterns are stored in the reverse index by entry.id (the filename),
// since the patterns schema has no `data.id` field. The mapper in
// entriesToContentEntries falls back to entry.id when data.id is absent.
const links = getReverseLinks(reverseIndex, entry.id);

const blueprintFor = (archId: string) => architecture.find((b) => b.data.id === archId);
const blueprintByFilename = (filename: string) => architecture.find((b) => b.id === filename);

const collectionRoute: Record<string, string> = {
  chapters: '/book',
  fieldNotes: '/field-notes',
  recipes: '/recipes',
  projects: '/projects',
  evidence: '/evidence',
  labs: '/labs',
  patterns: '/patterns',
  architecture: '/architecture',
};
---

<PageLayout
  title={`${meta.name}, Patterns`}
  description={d.description}
  currentNav="Patterns"
>
  <Container>
    <Reader>
      <Tag>{meta.kind === 'pattern' ? 'Pattern' : 'Anti-pattern'}</Tag>
      <KineticHeading level={1}>{meta.name}</KineticHeading>
      <Dek italic>{meta.oneLine}</Dek>

      <PatternCard entry={meta} forces={d.forces} />

      {d.diagram && (
        <ArchitectureDiagram wide src={d.diagram} alt={`${meta.name} pattern diagram`} />
      )}

      <article class="pattern-body">
        <slot />
      </article>

      {meta.blueprints && meta.blueprints.length > 0 && (
        <section class="pattern-specified-in">
          <h2>Specified in</h2>
          <ul>
            {meta.blueprints.map((id) => {
              const b = blueprintFor(id);
              return b ? (
                <li><a href={`/architecture/${b.id}/`}>{b.data.title}</a></li>
              ) : null;
            })}
          </ul>
        </section>
      )}

      <Sources items={d.sources} />

      {links.mentionedIn.length > 0 && (
        <section class="pattern-used-in">
          <h2>Used in</h2>
          <ul>
            {links.mentionedIn.map((l) => {
              // Architecture links resolve to a blueprint's title, the same way the
              // "Specified in" band above renders `b.data.title` rather than a raw id.
              const label = l.collection === 'architecture'
                ? (blueprintByFilename(l.id)?.data.title ?? `${l.collection}/${l.id}`)
                : `${l.collection}/${l.id}`;
              return (
                <li><a href={`${collectionRoute[l.collection] ?? ''}/${l.id}/`}>{label}</a></li>
              );
            })}
          </ul>
        </section>
      )}
    </Reader>
  </Container>
</PageLayout>

<style>
  .pattern-body {
    margin-top: var(--space-5);
    font-size: var(--body-1);
    line-height: var(--lh-base);
  }

  .pattern-body :global(p),
  .pattern-body :global(ul) {
    margin: 0 0 var(--space-4);
  }

  .pattern-specified-in,
  .pattern-used-in {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--fg-faint);
  }

  .pattern-specified-in h2,
  .pattern-used-in h2 {
    font-family: var(--font-mono);
    font-size: var(--meta-2);
    text-transform: uppercase;
    letter-spacing: var(--tracking-loose);
    color: var(--fg-light);
  }

  .pattern-specified-in ul,
  .pattern-used-in ul { list-style: none; padding: 0; }
  .pattern-specified-in a,
  .pattern-used-in a { font-family: var(--font-mono); font-size: var(--body-3); color: var(--fg); }
</style>

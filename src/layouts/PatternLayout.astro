---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import PageLayout from './PageLayout.astro';
import Container from '~/components/layout/Container.astro';
import Reader from '~/components/layout/Reader.astro';
import KineticHeading from '~/components/universal/KineticHeading.astro';
import Dek from '~/components/universal/Dek.astro';
import Tag from '~/components/universal/Tag.astro';
import PatternCard from '~/components/universal/PatternCard.astro';
import ArchitectureDiagram from '~/components/universal/ArchitectureDiagram.astro';
import Sources from '~/components/universal/Sources.astro';
import { buildReverseIndex, getReverseLinks } from '~/lib/cross-links';
import { bySlug } from '~/data/pattern-language';

interface Props {
  entry: CollectionEntry<'patterns'>;
}

const { entry } = Astro.props;
const d = entry.data;
const meta = bySlug(entry.id);
if (!meta) throw new Error(`No pattern-language entry for ${entry.id}`);

const [chapters, fieldNotes, recipes, labs, evidence, projects, patterns, architecture] = await Promise.all([
  getCollection('chapters'),
  getCollection('fieldNotes'),
  getCollection('recipes'),
  getCollection('labs'),
  getCollection('evidence'),
  getCollection('projects'),
  getCollection('patterns'),
  getCollection('architecture'),
]);
const allEntries = [...chapters, ...fieldNotes, ...recipes, ...labs, ...evidence, ...projects, ...patterns, ...architecture];
// Several collections (fieldNotes, recipes, evidence, labs, architecture) carry a
// frontmatter `id` distinct from their collection id (the filename), but every
// collection here routes by the filename. `entriesToContentEntries` in
// content-helpers.ts keys an entry by frontmatter `data.id` when present, falling
// back to entry.id only when data.id is absent -- fine for its other callers, but
// wrong here, since it would key + link "Used in" mentions by the frontmatter id
// and 404 (as arch-001 did before architecture was special-cased, and as fn-001
// does now for field notes). Map every entry by hand instead, keyed on entry.id, so
// every "Used in" href lands on the entry's real route, for every collection.
const toContentEntries = (
  entries: { id: string; collection: string; data: { references?: string[]; cites?: string[]; patterns?: string[] } }[],
) =>
  entries.map((e) => ({
    id: e.id,
    collection: e.collection,
    references: e.data.references,
    cites: e.data.cites,
    patterns: e.data.patterns,
  }));
const reverseIndex = buildReverseIndex(toContentEntries(allEntries as any));
const links = getReverseLinks(reverseIndex, entry.id);

const blueprintFor = (archId: string) => architecture.find((b) => b.data.id === archId);

// Title lookups for the "Used in" band, mirroring how "Specified in" above renders
// `b.data.title` instead of a raw id. Every collection that can appear in
// `links.mentionedIn` has a `data.title` field except patterns, which has none --
// its display name lives in src/data/pattern-language.ts instead (see `bySlug`).
const titleIndex: Record<string, string> = {};
for (const e of chapters) titleIndex[`chapters:${e.id}`] = e.data.title;
for (const e of fieldNotes) titleIndex[`fieldNotes:${e.id}`] = e.data.title;
for (const e of recipes) titleIndex[`recipes:${e.id}`] = e.data.title;
for (const e of labs) titleIndex[`labs:${e.id}`] = e.data.title;
for (const e of evidence) titleIndex[`evidence:${e.id}`] = e.data.title;
for (const e of projects) titleIndex[`projects:${e.id}`] = e.data.title;
for (const e of architecture) titleIndex[`architecture:${e.id}`] = e.data.title;
const titleForLink = (l: { id: string; collection: string }) =>
  l.collection === 'patterns' ? bySlug(l.id)?.name : titleIndex[`${l.collection}:${l.id}`];

const collectionRoute: Record<string, string> = {
  chapters: '/book',
  fieldNotes: '/field-notes',
  recipes: '/recipes',
  projects: '/projects',
  evidence: '/evidence',
  labs: '/labs',
  patterns: '/patterns',
  architecture: '/architecture',
};
---

<PageLayout
  title={`${meta.name}, Patterns`}
  description={d.description}
  currentNav="Patterns"
>
  <Container>
    <Reader>
      <Tag>{meta.kind === 'pattern' ? 'Pattern' : 'Anti-pattern'}</Tag>
      <KineticHeading level={1}>{meta.name}</KineticHeading>
      <Dek italic>{meta.oneLine}</Dek>

      <PatternCard entry={meta} forces={d.forces} />

      {d.diagram && (
        <ArchitectureDiagram wide src={d.diagram} alt={`${meta.name} pattern diagram`} />
      )}

      <article class="pattern-body">
        <slot />
      </article>

      {meta.blueprints && meta.blueprints.length > 0 && (
        <section class="pattern-specified-in">
          <h2>Specified in</h2>
          <ul>
            {meta.blueprints.map((id) => {
              const b = blueprintFor(id);
              return b ? (
                <li><a href={`/architecture/${b.id}/`}>{b.data.title}</a></li>
              ) : null;
            })}
          </ul>
        </section>
      )}

      <Sources items={d.sources} />

      {links.mentionedIn.length > 0 && (
        <section class="pattern-used-in">
          <h2>Used in</h2>
          <ul>
            {links.mentionedIn.map((l) => {
              const label = titleForLink(l) ?? `${l.collection}/${l.id}`;
              return (
                <li><a href={`${collectionRoute[l.collection] ?? ''}/${l.id}/`}>{label}</a></li>
              );
            })}
          </ul>
        </section>
      )}
    </Reader>
  </Container>
</PageLayout>

<style>
  .pattern-body {
    margin-top: var(--space-5);
    font-size: var(--body-1);
    line-height: var(--lh-base);
  }

  .pattern-body :global(p),
  .pattern-body :global(ul) {
    margin: 0 0 var(--space-4);
  }

  .pattern-specified-in,
  .pattern-used-in {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--fg-faint);
  }

  .pattern-specified-in h2,
  .pattern-used-in h2 {
    font-family: var(--font-mono);
    font-size: var(--meta-2);
    text-transform: uppercase;
    letter-spacing: var(--tracking-loose);
    color: var(--fg-light);
  }

  .pattern-specified-in ul,
  .pattern-used-in ul { list-style: none; padding: 0; }
  .pattern-specified-in a,
  .pattern-used-in a { font-family: var(--font-mono); font-size: var(--body-3); color: var(--fg); }
</style>

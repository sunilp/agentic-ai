---
/**
 * RecipeLayout — verified, code-block-heavy treatment for Recipes.
 * Anatomy: ArticleHeader → Spot → VerifiedStamp → Prerequisites → RunItCTA → MDX body → Footer3Col (added in MDX).
 */
import type { CollectionEntry } from 'astro:content';
import PageLayout from './PageLayout.astro';
import Reader from '~/components/layout/Reader.astro';
import ArticleHeader from '~/components/universal/ArticleHeader.astro';
import Spot from '~/components/universal/Spot.astro';
import VerifiedStamp from '~/components/universal/VerifiedStamp.astro';
import Prerequisites from '~/components/universal/Prerequisites.astro';
import RunItCTA from '~/components/universal/RunItCTA.astro';

interface Props {
  entry: CollectionEntry<'recipes'>;
}

const { entry } = Astro.props;
const d = entry.data;

const chapterLabel = d.chapter.startsWith('ch-')
  ? `Ch ${parseInt(d.chapter.slice(3), 10)}`
  : d.chapter;
const dateLong = d.verifiedOn.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).toUpperCase();
const byline = ['SUNIL PRAKASH', dateLong, `${d.estimatedMinutes} MIN`, chapterLabel.toUpperCase()];
const ogImage = `/assets/banners/${d.id}.png`;
---

<PageLayout
  title={`${d.title} — Recipes`}
  description={d.description}
  ogImage={ogImage}
  currentNav="Recipes"
  articleData={{
    publishedTime: d.verifiedOn.toISOString(),
    section: 'Recipes',
    headline: d.title,
  }}
>
  <Reader>
    <ArticleHeader rubric={`RECIPE · ${d.id.toUpperCase()}`} title={d.title} dek={d.description} byline={byline} />
    {d.spot && <Spot src={d.spot} alt={d.spotCaption ?? ''} caption={d.spotCaption} />}
    <VerifiedStamp date={d.verifiedOn} versions={d.verifiedVersions} />
    <Prerequisites items={d.prerequisites} />
    <RunItCTA repo={d.runItRepo} />
    <article class="recipe-body prose prose--dropcap">
      <slot />
    </article>
  </Reader>
</PageLayout>

<style>
  .recipe-body :global(pre) {
    margin: var(--space-4) 0;
  }
</style>
